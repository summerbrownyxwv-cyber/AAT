          "text": ".mobile-drawer{background:#fff;color:var(--x-text-primary);overflow-y:auto;overscroll-behavior:contain}.drawer-nav a{font-family:var(--x-font-display);font-size:28px;letter-spacing:0;border-color:var(--x-border-subtle);grid-template-columns:1fr}.drawer-nav a span{display:none}"
        },
        {
          "line": 112,
          "text": "@media(max-width:767px){.text-only-hero .hero-aside{grid-column:1!important;grid-row:2}.text-only-hero{min-height:0}.site-disclosure summary{min-height:76px}}"
        },
        {
          "line": 113,
          "text": "@media(min-width:1025px) and (max-width:1250px){.header-brand-group .deck-link{display:none}.desktop-nav,.nav-stack{gap:24px}}"
        },
        {
          "line": 114,
          "text": "@media(max-width:1024px){.site-header{grid-template-columns:1fr auto}.desktop-nav{display:none}.brand-opening,.page-hero,.ai-editorial{gap:32px}.collection-section,.brand-links{grid-template-columns:1fr 2fr;gap:32px}.editorial-section{gap:32px}.wire-row{grid-template-columns:1fr 1fr;gap:32px}}"
        },
        {
          "line": 115,
          "text": "@media(max-width:767px){"
        },
        {
          "line": 125,
          "text": "@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}"
        },
        {
          "line": 126,
          "text": ".mobile-drawer{z-index:70}.drawer-head{flex-shrink:0;font-family:var(--x-font-sans)}"
        }
      ]
    }
  ]
}
